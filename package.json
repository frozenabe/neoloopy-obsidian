{
  "name": "neoloopy-obsidian",
  "version": "0.1.11",
  "description": "neoloopy Obsidian plugin — local-first causal-loop diagrams",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "npm run build && node test/smoke/smoke.cjs && node test/smoke/view-smoke.cjs",
    "test:ios": "node test/webkit/canvas-harness.mjs"
  },
  "keywords": [
    "obsidian",
    "systems-thinking",
    "causal-loop-diagram",
    "cld",
    "feedback-loops"
  ],
  "author": "neoloopy",
  "license": "MIT",
  "workspaces": ["packages/*"],
  "dependencies": {
    "@neoloopy/cld-canvas": "*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "obsidian": "^1.4.11",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9",
    "yaml": "^2.4.5"
  }
}
